# ---- build output ----
/build
/dist
*.pyc
__pycache__/

# ---- python envs (the old .venv pointed at a removed interpreter) ----
.venv/
.venv-re/

# ---- retool: rizin engine binaries (~120MB, fetched by retool doctor/setup) ----
/.tools/

# ---- retool: generated analysis artifacts ----
# re_out/projects/*.rzdb  = cached rizin analysis (124MB, fully regenerable)
# re_out/exports/*.csv    = derived from the project + re_symbols
/re_out/
/out/

# ---- retired Ghidra project (empty shell, analysis now lives in retool) ----
/avcam_re/ghidra_proj/
/avcam_re/out/
*.rzdb
*.gpr
*.rep/
# Ghidra project lock/scratch files wherever the retired project now lives
*.lock
*.lock~
avcam_proj/

# ---- firmware images, dumps and extracted payloads ----
# ~5.6 GB of camera firmware blobs.  They are re-dumpable from a device and git
# stores every blob forever, so they must never be committed.  Findings
# *extracted* from them (notes, CSVs, result JSON) stay tracked.
#
# Rules are scoped to the dump locations on purpose.  A blanket '*.dat' would
# also swallow updatershell/fdat/CXD*.dat, which are tracked project inputs.
/dumps/
/fuzz_dat/
/fw/
/fw_update/*.dat
# Defence in depth.  The loose blobs (fdat_raw.bin, fdat_decrypted.bin,
# msc_dump.bin, the av-cam patch experiments) were consolidated into /dumps/,
# which is already ignored above.  These stay so that a future script writing a
# large blob into the root cannot commit it by accident.
/*.bin
/*.dat
/*.bak
/*.img
# generated by the old analysis scripts
/avcam_re/float_tables.txt
/avcam_re/_retired_ghidra/out/
