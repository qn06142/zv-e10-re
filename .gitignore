# ---- build output ----
/build
/dist
*.pyc
__pycache__/

# ---- python envs (the old .venv pointed at a removed interpreter) ----
.venv/
.venv-re/

# ---- retool: rizin engine binaries (~120MB, fetched by retool doctor/setup) ----
/.tools/

# ---- retool: generated analysis artifacts ----
# re_out/projects/*.rzdb  = cached rizin analysis (124MB, fully regenerable)
# re_out/exports/*.csv    = derived from the project + re_symbols
/re_out/
/out/

# ---- retired Ghidra project (empty shell, analysis now lives in retool) ----
/avcam_re/ghidra_proj/
/avcam_re/out/
*.rzdb
*.gpr
*.rep/
# Ghidra project lock/scratch files wherever the retired project now lives
*.lock
*.lock~
avcam_proj/

# ---- firmware images, dumps and extracted payloads ----
# ~5.6 GB of camera firmware blobs.  They are re-dumpable from a device and git
# stores every blob forever, so they must never be committed.  Findings
# *extracted* from them (notes, CSVs, result JSON) stay tracked.
#
# Rules are scoped to the dump locations on purpose.  A blanket '*.dat' would
# also swallow updatershell/fdat/CXD*.dat, which are tracked project inputs.
/dumps/
/fuzz_dat/
/fw/
/fw_update/*.dat
# Defence in depth.  The loose blobs (fdat_raw.bin, fdat_decrypted.bin,
# msc_dump.bin, the av-cam patch experiments) were consolidated into /dumps/,
# which is already ignored above.  These stay so that a future script writing a
# large blob into the root cannot commit it by accident.
/*.bin
/*.dat
/*.bak
/*.img
# generated by the old analysis scripts
/avcam_re/float_tables.txt
/avcam_re/_retired_ghidra/out/

# ---- third-party checkouts, vendored for reference only ----
# These are upstream projects with their own .git and their own history.  They
# were read, not modified, so committing a copy here would fork them and bloat
# the repo.  docs/ cites them by name and URL instead.
/fwtool_ma1co_repo/
/nex-hack/
/nex-hack-steelcnn/
# Sony's PC-side updater, shipped as-is next to the firmware image.
/fw_update/updater/

# ---- output written by the helper scripts in scripts/ ----
# Each writes next to itself, so they stay out of the repo root.
/scripts/fmt_result.txt
/scripts/fixreader_final.txt

# ---- session logs ----
# Written by research/device/zve10_retry.py into the repo root and /logs.
# Transient by nature: one file per serial session.
/zve10_shell.log
/logs/

# ---- binaries pulled off the device or carved out of firmware ----
# Same reasoning as /dumps/ above: these are re-obtainable from the hardware or
# regenerated by a tracked script, and git keeps every blob forever.  The
# findings drawn from them (elf_catalog.json, app_manifest.txt, the docs) are
# tracked.  Note tools/ is only partly ignored -- zx and README_zx.md are
# hand-written and stay.
/kmod/
/samples/
/udtrbody_extract/
/results/
/tools/*.elf
/tools/*.bin

# research/firmware/libtestcmd.OPX.so stays tracked on purpose.  It is nominally
# a build output of opx_payload.py, but it is the exact object whose md5 was
# verified on the camera, so it is evidence rather than a rebuildable
# intermediate.
