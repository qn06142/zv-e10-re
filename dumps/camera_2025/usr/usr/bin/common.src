#}

#second_led_off()
#{
#	uc_portctl.elf -c 0 -n 1
#	uc_portctl.elf -c 0 -n 2
#}

led_off()
{
	ms_led_off
#	second_led_off
}

firmup_success_exit()
{
	led_off

	echo ""
	echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
	echo ""
	echo "[FIRMUP OK]"
	echo ""
	echo "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
	
	updater_log.sh "Updater: END. FIRMUP OK!"
	exit 0
}

